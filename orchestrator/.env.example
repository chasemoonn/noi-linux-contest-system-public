CLOUD_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=cn-hangzhou
ALIYUN_INSTANCE_ID=i-xxxxxxxx
# 必须是目标 ECS 主网卡专属、非托管的普通 basic 安全组。
ALIYUN_DESKTOP_SECURITY_GROUP_ID=
# 必填且必须主动选择。来源未知时可显式填 0.0.0.0/0，但这会向公网开放
# 临时明文桌面入口；已知学生出口时优先填写更窄的 IPv4 CIDR。
STUDENT_DESKTOP_SOURCE_CIDR=
# OJ 主机固定公网 IP /32；其 TCP 22/80 管理规则必须长期保留。
CONTEST_SOURCE_CIDR=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-beijing
TENCENT_INSTANCE_ID=ins-xxxxxxxx
HYDRO_ORCHESTRATOR_TOKEN=replace-with-at-least-32-random-characters
HYDRO_PUBLIC_BASE_URL=https://oj.example.com
HYDRO_INTERNAL_BASE_URL=http://127.0.0.1:8888
HYDRO_MONGO_URI=mongodb://127.0.0.1:27017/hydro
HYDRO_DOMAIN_ID=system
ADMIN_PASSWORD=replace-with-a-long-random-password
CONTEST_SSH_USER=root
CONTEST_SSH_KEY=/absolute/host/path/to/contest.pem
CONTEST_KNOWN_HOSTS=/absolute/host/path/to/known_hosts
CONTEST_SSH_HOST_KEY_SHA256=SHA256:replace-with-contest-server-ed25519-fingerprint
# 固定 EIP 可写 http://198.51.100.10 或显式 :80，不允许其他端口。
GATEWAY_PUBLIC_BASE_URL=
ORCHESTRATOR_PUBLIC_BASE_URL=https://exam.example.com
FRONTEND_PROXY_PROVIDER=none
FRONTEND_DOMAIN=exam.example.com
FRONTEND_CADDY_DIR=/absolute/host/path/to/caddy-directory
ARTIFACT_TOOLS_DIR=/absolute/host/path/to/noi-artifact-tools
# 仅在 artifact_generation.enabled=true 时填写；不要写进 config.yaml。
NOI_ARTIFACT_AI_API_KEY=
