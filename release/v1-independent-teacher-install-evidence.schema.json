{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOI Linux V1 independent teacher install evidence",
  "type": "object", "additionalProperties": false,
  "required": ["$schema","schema_version","source","components","candidate","observed_at","host","teacher","checks","artifacts","signer","signing_public_key","signature"],
  "properties": {
    "$schema": {"const":"v1-independent-teacher-install-evidence.schema.json"}, "schema_version":{"const":1},
    "source":{"type":"object"}, "components":{"type":"object"},
    "candidate":{"type":"object"}, "observed_at":{"type":"string","format":"date-time"},
    "host":{"type":"object"}, "teacher":{"type":"object"}, "checks":{"type":"object"},
    "artifacts":{"type":"object","additionalProperties":false,"required":["install_log_sha256","rollback_receipt_sha256","ordinary_oj_before_sha256","ordinary_oj_after_sha256","clean_install_rehearsal_sha256"],"properties":{"install_log_sha256":{"$ref":"#/$defs/hex64"},"rollback_receipt_sha256":{"$ref":"#/$defs/hex64"},"ordinary_oj_before_sha256":{"$ref":"#/$defs/hex64"},"ordinary_oj_after_sha256":{"$ref":"#/$defs/hex64"},"clean_install_rehearsal_sha256":{"$ref":"#/$defs/hex64"}}}, "signer":{"type":"string"}, "signing_public_key":{"type":"string"},
    "signature":{"type":"string","minLength":32,"maxLength":16384}
  },
  "$defs":{"hex64":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
