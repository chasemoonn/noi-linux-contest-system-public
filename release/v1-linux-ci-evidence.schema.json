{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOI Linux V1 Linux CI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "status", "source", "environment", "started_at", "finished_at", "gates"],
  "properties": {
    "$schema": {"const": "v1-linux-ci-evidence.schema.json"},
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "effective_uid", "kernel", "node", "python", "system"],
      "properties": {
        "architecture": {"type": "string", "minLength": 1, "maxLength": 200},
        "effective_uid": {"const": 0},
        "kernel": {"type": "string", "minLength": 1, "maxLength": 200},
        "node": {"type": "string", "minLength": 1, "maxLength": 200},
        "python": {"type": "string", "minLength": 1, "maxLength": 200},
        "system": {"const": "linux"}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "gates": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["duration_ms", "name", "status", "stdout_file", "stdout_sha256", "stderr_file", "stderr_sha256"],
        "properties": {
          "duration_ms": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "passed"},
          "stdout_file": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9_]+\\.stdout\\.log$"},
          "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stderr_file": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9_]+\\.stderr\\.log$"},
          "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
