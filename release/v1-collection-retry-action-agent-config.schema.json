{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOI Linux V1 qualification-only collection retry action agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_marker", "session_id", "contest_id", "source", "components", "common_library_path", "common_library_sha256", "docker_socket", "controller", "database_path", "expected_failed_row_sha256", "failure_marker_host_path", "failure_marker_container_path", "controller_config_host_path", "controller_config_sha256", "collected_root_host_path", "collected_root_container_path", "admin_url", "admin_credentials_path", "controller_health", "submission_status", "ordinary_oj", "signer", "signing_public_key", "signing_key_path", "ssh_keygen_path", "lock_path", "recovery_state_path", "receipt_path", "output_path"],
  "properties": {
    "schema_version": {"const": 1},
    "qualification_marker": {"type": "string", "pattern": "^NOI-V1-QUAL-[A-Z0-9]{16,64}$"},
    "session_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contest_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "source": {"type": "object"},
    "components": {"type": "object"},
    "common_library_path": {"type": "string", "pattern": "^/"},
    "common_library_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "docker_socket": {"const": "/var/run/docker.sock"},
    "controller": {"type": "object"},
    "database_path": {"type": "string", "pattern": "^/"},
    "expected_failed_row_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "failure_marker_host_path": {"type": "string", "pattern": "^/"},
    "failure_marker_container_path": {"type": "string", "pattern": "^/app/data/qualification/[A-Za-z0-9_.-]{1,128}\\.json$"},
    "controller_config_host_path": {"type": "string", "pattern": "^/"},
    "controller_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "collected_root_host_path": {"type": "string", "pattern": "^/"},
    "collected_root_container_path": {"type": "string", "pattern": "^/"},
    "admin_url": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/admin$"},
    "admin_credentials_path": {"type": "string", "pattern": "^/"},
    "controller_health": {"type": "object"},
    "submission_status": {"type": "object"},
    "ordinary_oj": {"type": "object"},
    "signer": {"type": "string"},
    "signing_public_key": {"type": "string"},
    "signing_key_path": {"type": "string", "pattern": "^/"},
    "ssh_keygen_path": {"type": "string", "pattern": "^/"},
    "lock_path": {"type": "string", "pattern": "^/"},
    "recovery_state_path": {"type": "string", "pattern": "^/"},
    "receipt_path": {"type": "string", "pattern": "^/"},
    "output_path": {"type": "string", "pattern": "^/"}
  }
}
