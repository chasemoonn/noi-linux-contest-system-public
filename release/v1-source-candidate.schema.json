{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOI Linux V1 source candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "candidate",
    "source",
    "static_gates",
    "qualification"
  ],
  "properties": {
    "$schema": {"const": "v1-source-candidate.schema.json"},
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "product_contract"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "profile": {"const": "aliyun-hydro5-pm2-direct-v1"},
        "product_contract": {"const": "NOI Linux V1"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree", "archive", "tracked_file_count", "files"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256", "bytes", "root"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tar$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "bytes": {"type": "integer", "minimum": 1},
            "root": {"const": "noi-linux-contest-system-v1/"}
          }
        },
        "tracked_file_count": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mode": {"enum": ["100644", "100755"]},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "static_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_fault_injection", "v1_product_contract", "public_release_boundary"],
      "properties": {
        "submission_fault_injection": {"const": "passed"},
        "v1_product_contract": {"const": "passed"},
        "public_release_boundary": {"const": "passed"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_qualified", "report", "report_sha256"],
      "properties": {
        "production_qualified": {"type": "boolean"},
        "report": {"type": ["string", "null"]},
        "report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
